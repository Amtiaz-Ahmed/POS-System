<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background-color: #f8f9fa;
      margin: 0;
      padding: 0;
      display: flex;
    }

    /* Sidebar Styles */
    .sidebar {
      width: 220px;             /* Fixed width */
      height: 100vh;            /* Full height */
      background: #343a40;      /* Dark background */
      color: #fff;
      position: fixed;          /* Fixed position */
      top: 0;
      left: 0;
      padding-top: 20px;
    }

    .sidebar h4 {
      text-align: center;
      margin-bottom: 20px;
    }

    .sidebar a {
      display: block;
      padding: 12px 20px;
      color: #fff;
      text-decoration: none;
    }

    .sidebar a:hover {
      background: #495057;
    }

    /* Main content with sidebar offset */
    .content {
      margin-left: 220px;       /* Same as sidebar width */
      padding: 20px;
      width: calc(100% - 220px);
    }

    /* Product Cards */
    .product-card {
      background: #fff;
      border-radius: 8px;
      padding: 10px;
      margin-bottom: 15px;
      text-align: center;
      box-shadow: 0px 0px 5px rgba(0,0,0,0.1);
    }

    .cart-box {
      background: #fff;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body>

  <!-- Sidebar (partial include) -->
  <%- include("partials/sidebar") %>

  <!-- Main Content -->
  <div class="content">
    <%- body %>
  </div>

</body>
</html>
